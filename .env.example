# Folder holding candidate-profile.md (defaults to this project folder)
JOB_FOLDER=/Users/you/path/to/job-folder

# Gmail SMTP (use an app password: https://myaccount.google.com/apppasswords)
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional
RESULTS_WANTED=25
SEND_WHEN_EMPTY=false
SEND_PARTIAL_SCORES=false

# LinkedIn (own client): one sweep at most every LINKEDIN_MIN_HOURS, at most LINKEDIN_REQUEST_BUDGET requests
LINKEDIN_MIN_HOURS=4
LINKEDIN_REQUEST_BUDGET=40
LINKEDIN_DISTANCE_MILES=25
# blank = your profile's Locations; one city + distance covers its neighbours with fewer requests
LINKEDIN_SEARCH_LOCATIONS=Kitchener ON

# Schedule: mac (launchd) or windows (Task Scheduler); apply with `python -m collector schedule install`
SCHEDULE_PLATFORM=mac
SCHEDULE_HOURS=2
