# Folder holding candidate-profile.md (defaults to this project folder)
JOB_FOLDER=/Users/you/path/to/job-folder

# Gmail SMTP (use an app password: https://myaccount.google.com/apppasswords)
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional
RESULTS_WANTED=25
SEND_WHEN_EMPTY=false
